# ════════════════════════════════════════════════
# GameVibe 环境变量示例（复制为 .env 后填写）
# 注意：所有密钥仅后端使用，绝不暴露给前端
# ════════════════════════════════════════════════

# 服务端口（后端同源托管前端，单服务单端口）
SERVER_PORT=8792

# 运行环境（生产部署务必设为 production）
NODE_ENV=production

# 允许跨域的源（逗号分隔）。同源部署可留 *；独立前端域名时填该域名
CORS_ORIGIN=*

# ── JWT 鉴权（务必改成随机长字符串） ──
JWT_SECRET=change-me-to-a-long-random-string

# ── AI 引擎（国内推荐 DeepSeek，OpenAI 国内不可达） ──
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.deepseek.com/v1
VITE_AI_MODEL=deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── 真实游戏数据（可选，缺省走内置兜底） ──
# IGDB（免费申请 https://dev.twitch.tv/console/apps）
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# RAWG（https://rawg.io/apidashboard）
RAWG_API_KEY=
