# ════════════════════════════════════════════════
# GameVibe 环境变量示例（复制为 .env 后填写）
# 注意：所有密钥仅后端使用，绝不暴露给前端
# ════════════════════════════════════════════════

# 服务端口（后端同源托管前端，单服务单端口）
SERVER_PORT=8792

# 运行环境（生产部署务必设为 production）
NODE_ENV=production

# 允许跨域的源（逗号分隔）。同源部署可留 *；独立前端域名时填该域名
CORS_ORIGIN=*

# ── JWT 鉴权（务必改成随机长字符串） ──
JWT_SECRET=change-me-to-a-long-random-string

# ── AI 引擎（国内推荐 DeepSeek，OpenAI 国内不可达） ──
VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.deepseek.com/v1
VITE_AI_MODEL=deepseek-chat

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── 联网检索（可选） ──
# AI 助手的「游戏资讯」分支会联网取来源。两个都留空时自动退回免密钥的 Steam 官方动态。
# SERPER 优先，TAVILY 备选；任一可用即可，都用不上不会报错，只会回退。
# Serper（https://serper.dev）
SERPER_API_KEY=
# Tavily（https://tavily.com）
TAVILY_API_KEY=

# ── 以下为历史配置，当前版本的四平台直连方案不需要，留空即可 ──
# IGDB（https://dev.twitch.tv/console/apps）—— 需 OAuth 经 id.twitch.tv，部分网络不可达
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# RAWG（https://rawg.io/apidashboard）
RAWG_API_KEY=
