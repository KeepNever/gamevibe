{
  "name": "gamevibe",
  "private": true,
  "version": "0.1.0-vue3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "server": "node --env-file=.env --no-warnings server/index.ts",
    "server:typecheck": "tsc -p tsconfig.server.json",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm:server\"",
    "dist:local": "node scripts/syncDist.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@tailwindcss/vite": "^4.3.2",
    "echarts": "^5.5.1",
    "hono": "^4.12.29",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
